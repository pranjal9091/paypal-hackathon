# Outcome Exchange - Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# PayPal Sandbox API Credentials
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# SQLite Database Location
DATABASE_URL=sqlite:///./outcome_exchange.db

# Optional AI Model API Key (Gemini or OpenAI)
# If omitted, local deterministic fallbacks will be used seamlessly.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Backend and Frontend URLs
API_HOST=127.0.0.1
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_client_id_here
